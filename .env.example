# Copia este archivo como .env (en la raiz del repositorio) y llena los valores.
# El archivo .env no se sube a Git.

# --- Base de datos (Supabase / PostgreSQL) ---
SPRING_DATASOURCE_URL=jdbc:postgresql://HOST:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# validate: no modifica las tablas. Usa update solo con una base de datos local.
SPRING_JPA_HIBERNATE_DDL_AUTO=validate

# --- Seguridad ---
# Minimo 32 caracteres. Se puede generar con: openssl rand -base64 64 | tr -d '\n'
APP_SECURITY_SECRETKEY=
APP_SECURITY_EXPIRATIONMINUTES=60
# Ponlo en true si la aplicacion se sirve por HTTPS
APP_SECURITY_COOKIE_SECURE=false
# Origenes del frontend permitidos, separados por coma
APP_CORS_ALLOWED_ORIGINS=http://localhost:*

# --- Frontend (solo para desarrollo con npm run dev) ---
VITE_API_HOST=http://localhost:8080
